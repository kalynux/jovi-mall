{
  "name": "jovi-mall-backend",
  "version": "1.0.0",
  "description": "Custom commerce platform backend",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "lint": "eslint src --max-warnings 0",
    "aggregate:analytics": "ts-node scripts/populate-vendor-analytics.ts",
    "backfill:last-ordered": "ts-node scripts/backfill-last-ordered-at.ts",
    "backfill:pickup-locations": "ts-node scripts/backfill-pickup-locations.ts",
    "migrate:customer-payment-methods": "ts-node scripts/migrate-customer-payment-methods.ts",
    "migrate:agent-memberships": "ts-node scripts/migrate-agent-memberships.ts",
    "migrate:agent-deposits": "ts-node scripts/migrate-agent-deposits.ts",
    "migrate:billing-owner-scope": "ts-node scripts/migrate-billing-owner-scope.ts",
    "test:agent-domain": "ts-node scripts/test/test-agent-domain.ts",
    "test:agent-action-audit": "ts-node scripts/test/test-agent-action-audit.ts",
    "test:assignment": "ts-node scripts/test/test-assignment.ts",
    "seed:tickets": "ts-node scripts/seed/seed-tickets.ts",
    "seed:tickets:clean": "ts-node scripts/seed/seed-tickets.ts --clean",
    "seed:plans": "ts-node scripts/seed/seed-pricing-plans.ts",
    "seed:cod": "ts-node scripts/seed/seed-cod.ts",
    "seed:cod:clean": "ts-node scripts/seed/seed-cod.ts --clean",
    "seed:agent-app": "ts-node scripts/seed/seed-agent-app.ts",
    "seed:agent-app:clean": "ts-node scripts/seed/seed-agent-app.ts --clean",
    "simulate:notifications": "ts-node scripts/simulate-vendor-notifications.ts"
