{{!--
  The call-to-action button.

  ⚠ **A bulletproof button is a TABLE with padding on the cell, not a styled <a>.** Outlook's
  Word engine ignores padding and border-radius on an inline element, so the common
  `<a style="padding:12px 24px;background:...">` renders there as bare coloured text with no
  shape — the single most common defect in transactional email.

  The <a> still carries the padding as well, for clients that collapse the cell.

  Usage:  {{> mail-button url=link label="Verify my email" brandColor=brandColor}}
--}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" class="btn" style="margin:0 auto;">
  <tr>
    <td align="center" bgcolor="{{brandColor}}" style="background:{{brandColor}};border-radius:8px;">
      <a href="{{url}}" target="_blank" rel="noopener" style="display:inline-block;padding:14px 32px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;font-weight:600;line-height:20px;color:#ffffff;text-decoration:none;border-radius:8px;">{{label}}</a>
    </td>
  </tr>
</table>
