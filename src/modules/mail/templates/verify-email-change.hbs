{{> mail-head preheader="Confirm this is your new email address."}}

<h1 class="h1 tx" style="margin:0 0 16px;font-size:26px;line-height:34px;font-weight:700;color:#111827;letter-spacing:-0.3px;">Confirm your new email</h1>

<p class="tx" style="margin:0 0 12px;font-size:16px;line-height:26px;color:#374151;">
  Someone asked to change the email address on a {{brandName}} account to this one:
</p>

{{!-- The address is shown in a panel rather than inline: it is the fact the recipient has to
      check, and an address buried mid-sentence is the part people skim past. --}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
  <tr><td style="background:#f9fafb;border:1px solid #e6e8eb;border-radius:10px;padding:16px 18px;" align="center">
    <span style="font-size:16px;line-height:24px;font-weight:600;color:#111827;word-break:break-all;">{{newEmail}}</span>
  </td></tr>
</table>

<p class="tx-muted" style="margin:0 0 28px;font-size:16px;line-height:26px;color:#4b5563;">
  Confirm it below and this becomes the address you sign in with.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" style="padding:4px 0 28px;">
  {{> mail-button url=link label="Confirm this address"}}
</td></tr></table>

<p class="tx-muted" style="margin:0 0 24px;font-size:14px;line-height:22px;color:#6b7280;" align="center">
  This link expires in <strong style="color:#374151;">{{hours}} hours</strong>.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
  <tr><td style="background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:16px 18px;">
    <p style="margin:0;font-size:14px;line-height:22px;color:#92400e;">
      <strong>Didn't ask for this?</strong> Do not confirm. The address on the account stays
      unchanged, and you should tell us at
      <a href="mailto:{{supportEmail}}" style="color:#92400e;">{{supportEmail}}</a>.
    </p>
  </td></tr>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="rule" style="border-top:1px solid #e6e8eb;font-size:0;line-height:0;height:1px;">&nbsp;</td></tr></table>

<p class="tx-muted" style="margin:24px 0 8px;font-size:13px;line-height:20px;color:#6b7280;">
  Button not working? Paste this into your browser:
</p>
<p style="margin:0;font-size:13px;line-height:20px;word-break:break-all;">
  <a href="{{link}}" style="color:{{brandColor}};text-decoration:underline;">{{link}}</a>
</p>

{{> mail-foot}}
