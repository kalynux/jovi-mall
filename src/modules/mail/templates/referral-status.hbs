{{> mail-head preheader=title}}

<h1 class="h1 tx" style="margin:0 0 16px;font-size:26px;line-height:34px;font-weight:700;color:#111827;letter-spacing:-0.3px;">{{title}}</h1>

<p class="tx" style="margin:0 0 20px;font-size:16px;line-height:26px;color:#374151;">
  {{message}}
</p>

{{#if link}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" style="padding:4px 0 28px;">
  {{> mail-button url=link label=buttonLabel}}
</td></tr></table>
{{/if}}

{{> mail-foot}}
