{{> mail-head preheader="Your account is ready. Here is how to get started."}}

<h1 class="h1 tx" style="margin:0 0 16px;font-size:26px;line-height:34px;font-weight:700;color:#111827;letter-spacing:-0.3px;">Welcome, {{name}} 👋</h1>

<p class="tx" style="margin:0 0 12px;font-size:16px;line-height:26px;color:#374151;">
  Your {{brandName}} account is active and you are signed up as a <strong style="color:#111827;">{{role}}</strong>.
</p>
<p class="tx-muted" style="margin:0 0 28px;font-size:16px;line-height:26px;color:#4b5563;">
  Everything you need is on your dashboard — profile, listings, orders and deliveries all live there.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" style="padding:4px 0 28px;">
  {{> mail-button url=storefrontUrl label="Open my dashboard"}}
</td></tr></table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="rule" style="border-top:1px solid #e6e8eb;font-size:0;line-height:0;height:1px;">&nbsp;</td></tr></table>

<p class="tx-muted" style="margin:24px 0 0;font-size:14px;line-height:22px;color:#6b7280;">
  Need a hand getting set up? Just reply to this email — a real person reads it.
</p>

{{> mail-foot}}
