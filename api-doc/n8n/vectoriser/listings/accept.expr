={{ JSON.stringify({ success: true, job_id: $execution.id, accepted: $('accept job').all().filter(i => i.json.accepted).map(i => String(i.json.product_id).indexOf('listing:') === 0 ? String(i.json.product_id).slice(8) : i.json.product_id), rejected: $('accept job').all().filter(i => !i.json.accepted).map(i => String(i.json.product_id || '').indexOf('listing:') === 0 ? ({ kind: 'listing', listing_id: String(i.json.product_id).slice(8), reason: i.json.reason }) : ({ product_id: i.json.product_id, reason: i.json.reason })), callback_url: $('accept job').first().json.callback_url }) }}