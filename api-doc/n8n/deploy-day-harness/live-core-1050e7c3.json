 "nodes": {
  "detect command": {
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    -1120,
    1328
   ],
   "parameters": {
    "jsCode": "// IS THIS MESSAGE A COMMAND? — and deliberately nothing more than that.\n//\n// ⭐ THE VOCABULARY MOVED SERVER-SIDE ON 2026-09-09, and this node used to hold it: every\n// command name, every alias, and the argument grammar. It holds none of them now. The\n// reason is the one `bot-surface.md` § 14.6 already gives about parsing a typed answer:\n//\n//   \"A typed answer is language-dependent and whatever reads it is not... That table would\n//    have lived in the automation layer, which is the one layer with no copy table.\"\n//\n// The alias table IS a five-language table — /chercher /buscar /procurar, /annuler\n// /cancelar. Keeping it here meant a vocabulary nobody translates, nobody reviews and\n// nobody notices has gone stale. jovi-mall parses now, and answers with a channel-ready\n// reply like every other turn.\n//\n// ⚠ THE RAW TEXT IS WHAT TRAVELS. Never Telegram's bot_command entity: it stops at a\n// hyphen, which is why /reset-password could only ever be read as /reset plus trailing\n// text — and why the vocabulary is now one word with no separators at all.\n\nconst inbound = $('Inbound').first().json;\nconst sync = $input.first().json;\n\nlet kind = '';\nlet payload = {};\n\nconst text = typeof inbound.text === 'string' ? inbound.text.trim() : '';\nconst onboardingPending = !!(sync && sync.data && sync.data.onboarding && sync.data.onboarding.next);\n\n// A failed /identity/sync is `route turn`'s business — a 4xx body renders its own refusal.\nif (sync && sync.success !== false) {\n  if (inbound.kind === 'contact' && inbound.contact && !onboardingPending) {\n    // ⚠ A CONTACT IS A TAP, NOT TYPED TEXT, so it keeps the webhook command bus rather than\n    // going to the parser. It also runs ONLY once onboarding is finished: while the\n    // checklist still wants the phone step, `route onboarding` must have the contact — it\n    // is the same number, and binding it there is what completes registration. Afterwards a\n    // contact can only be answering the request_contact keyboard /login or /password put\n    // up, and the PLATFORM's pending intent decides which. n8n never branches on that.\n    kind = 'contact';\n    payload = {\n      contact: {\n        phone_number: String(inbound.contact.phoneNumber || ''),\n        user_id: inbound.contact.userId,\n        first_name: inbound.contact.firstName || undefined,\n        last_name: inbound.contact.lastName || undefined\n      },\n      username: inbound.handle ? String(inbound.handle).replace(/^@/, '') : undefined\n    };\n  } else if (inbound.kind === 'text' && text.charAt(0) === '/') {\n    // That is the whole test. Which command it is, whether it exists, what its arguments\n    // mean and what to say about a typo are all the backend's now.\n    kind = 'slash';\n  }\n}\n\nreturn [{ json: Object.assign({}, sync, { _kind: kind, _payload: payload }) }];"
   }
  },
