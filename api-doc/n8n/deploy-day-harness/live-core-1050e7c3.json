   "parameters": {
    "jsCode": "// The backend words every ordinary outcome AND attaches a channel-ready `reply` to it, so\n// the common paths — the credential, every refusal, the request_contact keyboard — arrive\n// here already renderable and pass straight through.\n//\n// This covers the rest: a genuine error envelope carries a sentence but no envelope.\n//\n// ⚠ It wraps the BACKEND'S sentence and never writes one. That is what keeps \"the bot relays,\n// never renders\" true here — n8n holds no copy table and no button labels, only the two wire\n// shapes, and those come from channel-reply.ts on every other path.\nconst r = $input.first().json || {};\nif (r.reply) { return [{ json: r }]; }\n\nconst inbound = $('Inbound').first().json;\nconst text = (r.error && (r.error.customerMessage || r.error.message)) || '';\n\n// No sentence at all means there is nothing honest to say; `has reply?` sends this to the\n// model rather than leaving the customer in silence. On this surface an empty 200 is still\n// a TURN — the lesson the address-picker taught on 2026-09-06.\nif (!text) { return [{ json: Object.assign({}, r, { reply: null }) }]; }\n\nconst reply = inbound.channel === 'telegram'\n  ? { channel: 'telegram', method: 'sendMessage', body: { chat_id: inbound.externalId, text: text } }\n  : { channel: 'whatsapp', method: 'messages', body: { messaging_product: 'whatsapp', recipient_type: 'individual', to: inbound.externalId, type: 'text', text: { body: text, preview_url: false } } };\n\nreturn [{ json: Object.assign({}, r, { reply: reply }) }];"
   }
